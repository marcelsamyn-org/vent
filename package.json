    "prepublishOnly": "npm run build",
    "vent": "node dist/cli.js"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
